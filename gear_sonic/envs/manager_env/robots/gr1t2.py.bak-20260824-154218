def _load_gr1t2_names():
    urdf_root = ETree.parse(GR1T2_URDF_PATH).getroot()
    urdf_joints = {joint.get("name"): joint for joint in urdf_root.findall("joint")}
    missing = [name for name in GR1T2_MUJOCO_JOINTS if name not in urdf_joints]
    if missing:
        raise ValueError(f"GR1T2 URDF is missing policy joints: {missing}")

    policy_set = set(GR1T2_MUJOCO_JOINTS)

    # IMPORTANT:
    # IsaacLab articulation order is NOT assumed to equal textual URDF order.
    # Use the verified runtime articulation joint order.
    isaaclab_joints = list(GR1T2_ISAACLAB_JOINTS)

    isaaclab_bodies = ["base_link"] + [
        urdf_joints[name].find("child").get("link") for name in isaaclab_joints
    ]
    extra_joints = [
        joint.get("name") for joint in urdf_root.findall("joint")
        if joint.get("name") not in policy_set and joint.get("name") != "floating_base"
    ]

    mjcf_root = ETree.parse(GR1T2_MJCF_PATH).getroot().find("worldbody/body")
    if mjcf_root is None:
        raise ValueError(f"GR1T2 MJCF has no worldbody root: {GR1T2_MJCF_PATH}")
    mjcf_bodies = []

    def visit(body):
        mjcf_bodies.append(body.get("name"))
        for child in body.findall("body"):
            visit(child)

    visit(mjcf_root)
    policy_body_set = set(isaaclab_bodies)
    mujoco_policy_bodies = [name for name in mjcf_bodies if name in policy_body_set]
    return isaaclab_joints, isaaclab_bodies, extra_joints, mjcf_bodies, mujoco_policy_bodies


